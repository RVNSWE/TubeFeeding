<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:TubeFeeding.PageModels"
             x:Class="TubeFeeding.Pages.PatientDetailsPage"
             x:DataType="pageModels:PatientPageModel"
             Title="Tube Feeding Schedule">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}" Padding="{StaticResource LayoutPadding}">

                <ScrollView Orientation="Horizontal">
                    <Grid ColumnDefinitions="Auto,Auto,Auto"
                          RowDefinitions="*,*,*,*,*,*,*,*,*,*,*,*"
                          MinimumHeightRequest="{OnIdiom 44, Desktop=60}"
                          ColumnSpacing="{StaticResource LayoutSpacing}"
                          RowSpacing="{StaticResource LayoutSpacing}"
                          HorizontalOptions="Center" >
                        <Label Text="Patient:" Style="{StaticResource Body1Strong}" HorizontalTextAlignment="End"  />
                        <Label Text="{Binding NameString}" Style="{StaticResource Body1}" Grid.Column="1" />

                        <Label Text="Client name:" Style="{StaticResource Body1Strong}" HorizontalTextAlignment="End"  Grid.Row="1" />
                        <Label Text="{Binding ClientName}" Style="{StaticResource Body1}" Grid.Column="1" Grid.Row="1" />

                        <Label Text="Species:" Style="{StaticResource Body1Strong}" HorizontalTextAlignment="End"  Grid.Row="2" />
                        <Label Text="{Binding Species}" Style="{StaticResource Body1}" Grid.Column="1" Grid.Row="2" />

                        <Label Text="Body weight:" Style="{StaticResource Body1Strong}" HorizontalTextAlignment="End"  Grid.Row="3" />
                        <Label Text="{Binding WeightString}" Style="{StaticResource Body1}" Grid.Column="1" Grid.Row="3" />

                        <Label Text="Diet name:" Style="{StaticResource Body1Strong}" HorizontalTextAlignment="End"  Grid.Row="4" />
                        <Label Text="{Binding FoodName}" Style="{StaticResource Body1}" Grid.Column="1" Grid.Row="4" />

                        <Label Text="Diet kcal/ml:" Style="{StaticResource Body1Strong}" HorizontalTextAlignment="End"  Grid.Row="5" />
                        <Label Text="{Binding KcalString}" Style="{StaticResource Body1}" Grid.Column="1" Grid.Row="5" />

                        <Label Text="Containers per day:" Style="{StaticResource Body1Strong}" HorizontalTextAlignment="End"  Grid.Row="6" />
                        <Label Text="{Binding CansPerDay}" Style="{StaticResource Body1}" Grid.Column="1" Grid.Row="6" />

                        <Label Text="Feeds per day:" Style="{StaticResource Body1Strong}" HorizontalTextAlignment="End"  Grid.Row="7" />
                        <Label Text="{Binding MealsPerDay}" Style="{StaticResource Body1}" Grid.Column="1" Grid.Row="7" />

                        <Label Text="Max meal volume:" Style="{StaticResource Body1Strong}" HorizontalTextAlignment="End"  Grid.Row="8" />
                        <Label Text="{Binding MaxVolString}" Style="{StaticResource Body1}" Grid.Column="1" Grid.Row="8" />

                        <Label Text="Food per meal:" Style="{StaticResource Body1Strong}" HorizontalTextAlignment="End"  Grid.Row="9" />
                        <Label Text="{Binding FoodPerMealString}" Style="{StaticResource Body1}" Grid.Column="1" Grid.Row="9" />

                        <Label Text="Water added:" Style="{StaticResource Body1Strong}" HorizontalTextAlignment="End"  Grid.Row="10" />
                        <Label Text="{Binding WaterPerMealString}" Style="{StaticResource Body1}" Grid.Column="1" Grid.Row="10" />

                        <Label Text="Water per flush:" Style="{StaticResource Body1Strong}" HorizontalTextAlignment="End"  Grid.Row="11" />
                        <Label Text="{Binding FlushString}" Style="{StaticResource Body1}" Grid.Column="1" Grid.Row="11" />
                    </Grid>
                </ScrollView>

                <Button x:Name="btnCreatePDF"
                        MinimumHeightRequest="{OnIdiom 44, Desktop=60}"
                        Text="Export to PDF"
                        Margin="30" />

                <Button x:Name="btnDeleteSchedule"
                        MinimumHeightRequest="{OnIdiom 44, Desktop=60}"
                        Text="Delete schedule"
                        Margin="30"
                        BackgroundColor="#d76f8b" />

            </VerticalStackLayout>

        </ScrollView>
    </Grid>

</ContentPage>