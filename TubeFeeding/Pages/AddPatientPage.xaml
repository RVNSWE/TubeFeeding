<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:pages="clr-namespace:TubeFeeding.PageModels"
             xmlns:local="clr-namespace:TubeFeeding"
             x:Class="TubeFeeding.Pages.AddPatientPage"
             x:DataType="pages:AddPatientPageModel"
             Title="Create Feeding Plan">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}" Padding="{StaticResource LayoutPadding}" >

                <Grid Margin="20">
                    <Label Text="{Binding PatientNameHelper}" TextColor="{StaticResource WarningColour}" LineHeight="0.1" />
                    <sf:SfTextInputLayout Hint="Patient"
                                      HelperText="The patient's name"
                                      CharMaxLength="30"
                                      ContainerType="Outlined">
                        <Entry x:Name="newPatientName"
                               SemanticProperties.Description="Patient name">
                            <Entry.Behaviors>
                                <toolkit:TextValidationBehavior
                                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                                    ValidStyle="{StaticResource ValidEntryStyle}"
                                    Flags="ValidateOnValueChanged"
                                    MinimumLength="1" />
                            </Entry.Behaviors>
                        </Entry>
                    </sf:SfTextInputLayout>
                </Grid>

                <Grid Margin="20">
                    <Label Text="{Binding ClientNameHelper}" TextColor="{StaticResource WarningColour}" LineHeight="0.1" />
                    <sf:SfTextInputLayout Hint="Client"
                                      HelperText="The client's surname"
                                      CharMaxLength="30"
                                      ContainerType="Outlined">
                        <Entry x:Name="newClientName"
                           SemanticProperties.Description="Client surname">
                            <Entry.Behaviors>
                                <toolkit:TextValidationBehavior
                                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                                    ValidStyle="{StaticResource ValidEntryStyle}"
                                    Flags="ValidateOnValueChanged"
                                    MinimumLength="1" />
                            </Entry.Behaviors>
                        </Entry>
                    </sf:SfTextInputLayout>
                </Grid>

                <Grid Margin="20">
                    <Label Text="{Binding SpeciesHelper}" TextColor="{StaticResource WarningColour}" LineHeight="0.1" />
                    <sf:SfTextInputLayout Hint="Species"
                                      HelperText="Select the species"
                                      ContainerType="Outlined">
                        <Picker x:Name="picker"
                            Title="Select a species">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Cat</x:String>
                                    <x:String>Dog</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </sf:SfTextInputLayout>
                </Grid>

                <Grid Margin="20">
                    <Label Text="{Binding BodyWeightHelper}" TextColor="{StaticResource WarningColour}" LineHeight="0.1" />
                    <sf:SfTextInputLayout Hint="Body weight in kg"
                                      HelperText="Eg. 10kg"
                                      CharMaxLength="6"
                                      ContainerType="Outlined">
                        <Entry x:Name="newBodyWeight"
                           SemanticProperties.Description="Patient body weight (kg)"
                           Keyboard="Numeric">
                            <Entry.Behaviors>
                                <toolkit:NumericValidationBehavior
                                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                                    ValidStyle="{StaticResource ValidEntryStyle}"
                                    Flags="ValidateOnValueChanged"
                                    MinimumValue="0.001"
                                    MaximumValue="200.0" />
                            </Entry.Behaviors>
                        </Entry>
                    </sf:SfTextInputLayout>
                </Grid>

                <Grid Margin="20">
                    <Label Text="{Binding DietHelper}" TextColor="{StaticResource WarningColour}" LineHeight="0.1" />
                    <sf:SfTextInputLayout Hint="Diet"
                                      HelperText="The name of the diet to be fed"
                                      CharMaxLength="30"
                                      ContainerType="Outlined">
                        <Entry x:Name="newFoodName"
                           SemanticProperties.Description="The name of the diet to be fed">
                            <Entry.Behaviors>
                                <toolkit:TextValidationBehavior
                                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                                    ValidStyle="{StaticResource ValidEntryStyle}"
                                    Flags="ValidateOnValueChanged"
                                    MinimumLength="1" />
                            </Entry.Behaviors>
                        </Entry>
                    </sf:SfTextInputLayout>
                </Grid>

                <Grid Margin="20">
                    <Label Text="{Binding KcalHelper}" TextColor="{StaticResource WarningColour}" LineHeight="0.1" />
                    <sf:SfTextInputLayout Hint="Diet kcal per kg"
                                      HelperText="Eg. 1000"
                                      CharMaxLength="7"
                                      ContainerType="Outlined">
                        <Entry x:Name="newKcal"
                           SemanticProperties.Description="Kcals per kg of food"
                           Keyboard="Numeric">
                            <Entry.Behaviors>
                                <toolkit:NumericValidationBehavior
                                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                                    ValidStyle="{StaticResource ValidEntryStyle}"
                                    Flags="ValidateOnValueChanged"
                                    MinimumValue="1.0" />
                            </Entry.Behaviors>
                        </Entry>
                    </sf:SfTextInputLayout>
                </Grid>

                <Grid Margin="20">
                    <Label Text="{Binding NetWeightHelper}" TextColor="{StaticResource WarningColour}" LineHeight="0.1" />
                    <sf:SfTextInputLayout Hint="Food per container"
                                      HelperText="Net volume or weight in ml or g, eg. 180"
                                      CharMaxLength="6"
                                      ContainerType="Outlined">
                        <Entry x:Name="newNetWeight"
                           SemanticProperties.Description="Weight (g) or volume (ml) of food per container"
                           Keyboard="Numeric">
                            <Entry.Behaviors>
                                <toolkit:NumericValidationBehavior
                                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                                    ValidStyle="{StaticResource ValidEntryStyle}"
                                    Flags="ValidateOnValueChanged"
                                    MinimumValue="1.0" />
                            </Entry.Behaviors>
                        </Entry>
                    </sf:SfTextInputLayout>
                </Grid>

                <Grid Margin="20">
                    <Label Text="{Binding PercentWaterHelper}" TextColor="{StaticResource WarningColour}" LineHeight="0.1" />
                    <sf:SfTextInputLayout Hint="Percentage of water"
                                      HelperText="% water content of the food, eg. 77"
                                      CharMaxLength="3"
                                      ContainerType="Outlined">
                        <Entry x:Name="newWaterPercentage"
                           SemanticProperties.Description="Percentage water content of food"
                           Keyboard="Numeric">
                            <Entry.Behaviors>
                                <toolkit:NumericValidationBehavior
                                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                                    ValidStyle="{StaticResource ValidEntryStyle}"
                                    Flags="ValidateOnValueChanged"
                                    MinimumValue="1.0"
                                    MaximumValue="99.99" />
                            </Entry.Behaviors>
                        </Entry>
                    </sf:SfTextInputLayout>
                </Grid>

                <Label Text="{Binding ValidationFailureMessage}" TextColor="{StaticResource WarningColour}" LineHeight="0.1" />

                <Button x:Name="btnSave"
                        MinimumHeightRequest="{OnIdiom 44, Desktop=60}"
                        Text="Save"
                        Margin="30" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>