<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TubeFeeding.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TubeFeeding.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="TubeFeeding">

    <TabBar>
        <ShellContent Title="Main Page"
                      ContentTemplate="{DataTemplate pages:MainPage}"
                      Icon="beast2.png"
                      Route="main" />
        <ShellContent x:Name="ChartTab"
                      Title="Chart"
                      ContentTemplate="{DataTemplate pages:PatientDetailsPage}"
                      Route="main" />
    </TabBar>

</Shell>